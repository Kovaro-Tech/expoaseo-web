{
  "name": "expoaseo-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build.mjs",
    "lint": "eslint .",
    "preview": "node scripts/preview.mjs",
    "test": "node --test tests/*.test.mjs",
    "build:production": "node scripts/build.mjs --production",
    "build:staging": "node scripts/build.mjs --staging",
    "dev:worker": "wrangler dev --local --port 4173",
    "test:artifacts": "node tests/build-artifacts.mjs",
    "test:worker": "npm run check:worker && node --test tests/worker.runtime.mjs",
    "check:worker": "node scripts/check-worker.mjs",
    "test:browser": "node tests/preproduction.browser.mjs",
    "test:form": "node tests/form.browser.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.43.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "miniflare": "^5.20260930.0-alpha",
    "playwright": "^1.63.0",
    "vite": "^8.2.2",
    "wrangler": "^4.145.0"
  }
}
